# Variable names only. Copy to `.env` (ignored by Git and Docker) and set the values you need.
# Development and test fall back to the local Compose database when a POSTGRES_* variable is unset.
# Production (backend.config.settings.prod) requires every variable below except DEBUG.
# Write values as KEY=value, without quotes: the Makefile includes this file.

# Django
SECRET_KEY=
ALLOWED_HOSTS=
# Optional. Production refuses to start if this is true.
DEBUG=

# PostgreSQL (Compose `db` service and Django)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
